{
  "name": "dsh-git-control",
  "version": "0.4.3",
  "type": "module",
  "description": "Git source-control plugin for the DeepSeek Harness Web GUI: IDEA-style log view (branch tree, column list, multi-colour graph, merge dimming, date filters, keyboard navigation), colour-coded change tree with hunk staging, amend, stash, and an accurate session-header branch chip with switching and management.",
  "license": "MIT",
  "author": "wx-98",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wx-98/DSH-GIT.git"
  },
  "homepage": "https://github.com/wx-98/DSH-GIT#readme",
  "bugs": {
    "url": "https://github.com/wx-98/DSH-GIT/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/git.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "tools/graph-lanes.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/host.test.js test/client.test.js test/graph-lanes.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "source-control",
    "vscode",
    "idea"
  ]
}
